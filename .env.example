NVR_USERNAME=admin

NVR_01_PASSWORD='PASSWORD_FOR_NVR_01'
NVR_02_PASSWORD='PASSWORD_FOR_NVR_02'
NVR_03_PASSWORD='PASSWORD_FOR_NVR_03'
NVR_04_PASSWORD='PASSWORD_FOR_NVR_04'
NVR_05_PASSWORD='PASSWORD_FOR_NVR_05'
NVR_06_PASSWORD='PASSWORD_FOR_NVR_06'
NVR_07_PASSWORD='PASSWORD_FOR_NVR_07'
NVR_08_PASSWORD='PASSWORD_FOR_NVR_08'
NVR_09_PASSWORD='PASSWORD_FOR_NVR_09'
NVR_10_PASSWORD='PASSWORD_FOR_NVR_10'
NVR_11_PASSWORD='PASSWORD_FOR_NVR_11'
