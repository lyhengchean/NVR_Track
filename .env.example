NVR_USERNAME=admin

NVR_01_PASSWORD='PASSWORD_FOR_NVR_01'
NVR_02_PASSWORD='PASSWORD_FOR_NVR_02'
NVR_03_PASSWORD='PASSWORD_FOR_NVR_03'
NVR_04_PASSWORD='PASSWORD_FOR_NVR_04'
NVR_05_PASSWORD='PASSWORD_FOR_NVR_05'
NVR_06_PASSWORD='PASSWORD_FOR_NVR_06'
NVR_07_PASSWORD='PASSWORD_FOR_NVR_07'
NVR_08_PASSWORD='PASSWORD_FOR_NVR_08'
NVR_09_PASSWORD='PASSWORD_FOR_NVR_09'
NVR_10_PASSWORD='PASSWORD_FOR_NVR_10'
NVR_11_PASSWORD='PASSWORD_FOR_NVR_11'
NVR_12_PASSWORD='PASSWORD_FOR_NVR_12'

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=sender@gmail.com
SMTP_PASSWORD='YOUR_EMAIL_APP_PASSWORD'
SMTP_FROM=sender@gmail.com
SMTP_TO=recipient@example.com

DASHBOARD_USERNAME=username
DASHBOARD_PASSWORD='password'
DASHBOARD_BIND_IP=0.0.0.0
# HTTPS for the dashboard: run `sudo bash scripts/dashboard_cert.sh` once, then
# set true and recreate nvr-dashboard. http:// on the same port redirects to https://.
DASHBOARD_TLS=false
# Per-camera checks are enabled only for the listed NVR IDs.
NVR_PER_CAMERA_RECORDING_IDS=nvr-01
NVR_RECORDING_WINDOW_MINUTES=60
NVR_RECORDING_MAX_NVR_SECONDS=300
# Seconds to wait before retrying once after the NVR could not be reached (0 = no retry).
NVR_RECORDING_RETRY_DELAY_SECONDS=15
NVR_HISTORICAL_ENABLED=true
NVR_HISTORICAL_LOOKBACK_DAYS=7
NVR_HISTORICAL_MAX_CAMERAS_PER_RUN=8
NVR_HISTORICAL_CACHE_HOURS=12

# Read-only recording calendar (opt-in PILOT; do not enable fleet-wide until verified).
# Both ENABLED=true and an NVR ID in NVR_IDS are required for any new requests.
NVR_RETENTION_ENABLED=false
NVR_RETENTION_NVR_IDS=
NVR_RETENTION_WINDOW_DAYS=30
# 64 covers the largest NVR in one run; under 24 h makes the 08:00 run refresh
# every calendar daily (it then ends yesterday instead of up to 7 days ago).
NVR_RETENTION_MAX_CAMERAS_PER_RUN=64
NVR_RETENTION_CACHE_HOURS=20
# Expectation for channels not listed in recording_expectations:
# continuous (should always record), event, or unspecified.
NVR_DEFAULT_RECORDING_EXPECTATION=continuous

# Automatic scans by the nvr-scanner service (Cambodia time, HH:MM, comma-separated).
# Every 2 hours from 06:00 to 22:00; the email goes out only from the 08:00 scan.
NVR_SCAN_TIMES=06:00,08:00,10:00,12:00,14:00,16:00,18:00,20:00,22:00
NVR_EMAIL_TIMES=08:00
# Dashboard "Scan" button (all NVRs or one NVR). One scan at a time.
NVR_ON_DEMAND_SCANS=true
NVR_SCAN_COOLDOWN_SECONDS=60

# Days of footage every camera must keep (needs the recording calendar).
# 0 = off. Must not exceed NVR_RETENTION_WINDOW_DAYS to be checkable.
NVR_REQUIRED_RETENTION_DAYS=0
# Archive reports older than this many days once a day after a scheduled scan
# (into reports/archive/*.tar.gz, verified before originals are removed). 0 = off.
NVR_REPORT_ARCHIVE_DAYS=0

# Telegram bot (nvr-telegram service). Token from @BotFather - keep it secret.
# IDs: send /myid to the bot. Groups have negative IDs.
TELEGRAM_BOT_TOKEN=
# Who may read status (scans always need TELEGRAM_ADMIN_USER_IDS):
#   allowlist - only the user/group IDs below
#   group     - anyone in a group listed in TELEGRAM_ALLOWED_CHAT_IDS or
#               TELEGRAM_ALERT_CHAT_IDS (no IDs to collect; leave the group = lose access)
#   open      - anyone on Telegram who finds the bot
TELEGRAM_ACCESS=allowlist
# People who may never use the bot, whatever the mode.
TELEGRAM_BLOCKED_USER_IDS=
# May start scans (and read everything).
TELEGRAM_ADMIN_USER_IDS=
# May read status, problems, cameras, storage.
TELEGRAM_ALLOWED_USER_IDS=
# Every member of these groups may read status.
TELEGRAM_ALLOWED_CHAT_IDS=
# Chats (people or groups) that get alerts and the daily summary.
TELEGRAM_ALERT_CHAT_IDS=
TELEGRAM_DIGEST_TIME=08:30
# Weekly list of open known issues to the alert chats (day and time, or off).
TELEGRAM_KNOWN_REMINDER=mon 09:00
# Known issues open this many days are flagged for review (Telegram and email).
NVR_KNOWN_REMINDER_DAYS=7
# A camera whose live state changed this many times (2-50) within NVR_FLAP_HOURS
# (1-168) is "unstable": one warning and one Telegram alert instead of an
# offline/online alert at every scan.
NVR_FLAP_CHANGES=4
NVR_FLAP_HOURS=24
# Camera and NVR IP addresses are left out of Telegram messages unless true.
TELEGRAM_SHOW_IPS=false
NVR_CLOCK_DRIFT_WARN_SECONDS=120
# Only if this server reaches the internet through a proxy, e.g. http://proxy:3128
TELEGRAM_HTTPS_PROXY=

# ---- Add-ons ----
# GET /ISAPI/System/status each scan: NVR uptime, restart detection.
NVR_DEVICE_STATUS=true
# Disk SMART health (read-only GET per disk). Enable per NVR after
# scripts.probe_nvr_features shows SMART works on it. Re-read every N hours.
NVR_SMART_NVR_IDS=
NVR_SMART_CACHE_HOURS=24
# Snapshot checks: black, covered, frozen or moved pictures. One picture per
# online camera per scan, within NVR_SNAPSHOT_MAX_SECONDS. Thumbnails are kept
# in state/snapshots (latest only) unless NVR_SNAPSHOT_KEEP=false.
# References follow light and scene changes; a view must differ at
# NVR_SNAPSHOT_MOVED_SCANS scans in a row (1-6) before it is "view changed".
NVR_SNAPSHOT_NVR_IDS=
NVR_SNAPSHOT_MAX_SECONDS=180
NVR_SNAPSHOT_KEEP=true
NVR_SNAPSHOT_MOVED_SCANS=2
# ...and the last of them at least this many minutes after the first (0-720; 0 = scans only).
NVR_SNAPSHOT_MOVED_MINUTES=90
# Real-time events (nvr-events service): one alertStream connection per NVR.
NVR_EVENT_NVR_IDS=
# Same event within this many minutes is reported once.
NVR_EVENT_REPEAT_MINUTES=30
# Limit to some types (empty = all known): videoloss,shelteralarm,diskerror,diskfull,
# hdderror,diskunformat,nicbroken,ipconflict,illaccess,badvideo,videomismatch,recordexception
NVR_EVENT_TYPES=
# Live status (nvr-live service): camera online/offline, disk states and "not
# reachable" checked every NVR_LIVE_SECONDS (30-1800, default 60) between scans,
# so Telegram posts them within about 2 minutes. Two read-only GETs per NVR and check.
NVR_LIVE_NVR_IDS=
NVR_LIVE_SECONDS=60
# Monthly uptime report (email + Telegram) on the 1st.
NVR_UPTIME_MONTHLY=true
# Telegram: who may add repair notes (admins or users); pictures for admins or off.
TELEGRAM_NOTES_BY=admins
TELEGRAM_SNAPSHOTS=admins
# Picture problems (black, covered, frozen, view changed) are shown on the
# dashboard only. on = also alert in Telegram and count them in the daily summary.
TELEGRAM_PICTURE_ALERTS=off
# Per NVR and day: how often the same real-time alarm (e.g. Disk error, or Video loss
# on one camera) and an event-stream-down alert are posted (1-50). Repeats stay in /events.
TELEGRAM_EVENT_DAILY_LIMIT=1
# Event stream down this many minutes before it is alerted (0-1440); shorter drops
# (an NVR ends the stream now and then) are not posted.
TELEGRAM_STREAM_DOWN_MINUTES=10
