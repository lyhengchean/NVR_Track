NVR_USERNAME=admin

NVR_01_PASSWORD='PASSWORD_FOR_NVR_01'
NVR_02_PASSWORD='PASSWORD_FOR_NVR_02'
NVR_03_PASSWORD='PASSWORD_FOR_NVR_03'
NVR_04_PASSWORD='PASSWORD_FOR_NVR_04'
NVR_05_PASSWORD='PASSWORD_FOR_NVR_05'
NVR_06_PASSWORD='PASSWORD_FOR_NVR_06'
NVR_07_PASSWORD='PASSWORD_FOR_NVR_07'
NVR_08_PASSWORD='PASSWORD_FOR_NVR_08'
NVR_09_PASSWORD='PASSWORD_FOR_NVR_09'
NVR_10_PASSWORD='PASSWORD_FOR_NVR_10'
NVR_11_PASSWORD='PASSWORD_FOR_NVR_11'
NVR_12_PASSWORD='PASSWORD_FOR_NVR_12'

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=sender@gmail.com
SMTP_PASSWORD='YOUR_EMAIL_APP_PASSWORD'
SMTP_FROM=sender@gmail.com
SMTP_TO=recipient@example.com

DASHBOARD_USERNAME=username
DASHBOARD_PASSWORD='password'
DASHBOARD_BIND_IP=0.0.0.0
# Per-camera checks are enabled only for the listed NVR IDs.
NVR_PER_CAMERA_RECORDING_IDS=nvr-01
NVR_RECORDING_WINDOW_MINUTES=60
NVR_RECORDING_MAX_NVR_SECONDS=300
# Seconds to wait before retrying once after the NVR could not be reached (0 = no retry).
NVR_RECORDING_RETRY_DELAY_SECONDS=15
NVR_HISTORICAL_ENABLED=true
NVR_HISTORICAL_LOOKBACK_DAYS=7
NVR_HISTORICAL_MAX_CAMERAS_PER_RUN=8
NVR_HISTORICAL_CACHE_HOURS=12

# Read-only recording calendar (opt-in PILOT; do not enable fleet-wide until verified).
# Both ENABLED=true and an NVR ID in NVR_IDS are required for any new requests.
NVR_RETENTION_ENABLED=false
NVR_RETENTION_NVR_IDS=
NVR_RETENTION_WINDOW_DAYS=30
# 64 covers the largest NVR in one run; under 24 h makes the 08:00 run refresh
# every calendar daily (it then ends yesterday instead of up to 7 days ago).
NVR_RETENTION_MAX_CAMERAS_PER_RUN=64
NVR_RETENTION_CACHE_HOURS=20
# Expectation for channels not listed in recording_expectations:
# continuous (should always record), event, or unspecified.
NVR_DEFAULT_RECORDING_EXPECTATION=continuous

# Automatic scans by the nvr-scanner service (Cambodia time, HH:MM, comma-separated).
# Every 2 hours from 06:00 to 22:00; the email goes out only from the 08:00 scan.
NVR_SCAN_TIMES=06:00,08:00,10:00,12:00,14:00,16:00,18:00,20:00,22:00
NVR_EMAIL_TIMES=08:00
# Dashboard "Scan" button (all NVRs or one NVR). One scan at a time.
NVR_ON_DEMAND_SCANS=true
NVR_SCAN_COOLDOWN_SECONDS=60
